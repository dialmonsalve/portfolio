---
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl, getPathname } from "@/i18n/locales/utils";

import Header from "@/components/layout/Header.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import FAB from "@/components/FAB.astro";

import "../styles/global.css";
import Footer from "@/components/layout/Footer.astro";

interface Props {
  title: string;
  description: string;
  isNotFound?: boolean;
}

const { title, description, isNotFound = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const site = Astro.site ?? Astro.url.origin;
const routePath = getPathname(Astro.url)
  .replace(/^\/(es|en)(?=\/|$)/, "")
  .replace(/^\/$/, "");
const toAbsolute = (path: string) => new URL(path, site).href;
const canonicalUrl = toAbsolute(`/${lang}${routePath}`);
const alternates = [
  { hreflang: "es", href: toAbsolute(`/es${routePath}`) },
  { hreflang: "en", href: toAbsolute(`/en${routePath}`) },
  { hreflang: "x-default", href: toAbsolute(`/es${routePath}`) },
];
const ogLocale = lang === "en" ? "en_US" : "es_CO";
const ogLocaleAlternate = lang === "en" ? "es_CO" : "en_US";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {
      isNotFound ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <meta name="robots" content="index, follow" />
          <link rel="canonical" href={canonicalUrl} />
          {alternates.map(({ hreflang, href }) => (
            <link rel="alternate" hreflang={hreflang} href={href} />
          ))}
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta
      property="og:site_name"
      content="Portfolio Diego Monsalve - dialmonsalve"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={toAbsolute("/og-image.jpg")} />

    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={toAbsolute("/twitter-image.jpg")}
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="theme-color" content="#f0f0f0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <title>{title}</title>
    <script is:inline src="/js/theme.js"></script>
    <ClientRouter />
  </head>
  <body
    class="bg-[url('/images/background.webp')] bg-cover bg-center bg-no-repeat"
  >
    <Header />

    <main class="pt-14 p-1 lg:pt-10">
      <Breadcrumbs isNotFound={isNotFound} />
      <FAB />
    </main>
    <slot />
    <Footer />

    <script src="@/lib/animations/setup.ts"></script>

  </body>
</html>
