---
import { getI18N } from "@/i18n";

interface Props {
  href: string;
  label: string;
  className?: string;
  target?: "_blank" | "_self" | "_parent" | "_top";
}

const { href, label, className, target = "_self" } = Astro.props;

const i18n = getI18N({ currentLocale: Astro.currentLocale });
---

<li class="list-none">
  <a target={target} referrerpolicy="no-referrer" href={href} class={className}>
    {label}
    {target === "_blank" && <span class="sr-only">{i18n.general.newTab}</span>}
  </a>
</li>