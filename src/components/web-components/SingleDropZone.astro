---
import Icon from "../Icon.astro";
import { getI18N } from "@/i18n";

const i18n = getI18N({ currentLocale: Astro.currentLocale });
---

<dial-single-drop-zone
  data-folder=""
  data-type="desktop"
  data-page=""
  data-aspect="single-drop-zone"
  data-height={720}
  data-width={480}

>
  <div
    class="flex flex-col gap-2 h-130 w-8/10  lg:w-auto items-center mx-auto"
    id="parent-single-drop-zone"
  >
    <label
      for="single-file-upload"
      class="flex flex-col items-center justify-center border-2 border-dashed border-base-content/40 rounded-lg cursor-pointer hover:bg-base-200 single-drop-zone h-130 w-62.5 md:w-75 lg:w-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary"
      id="single-drop-zone"
    >
      <div class="flex flex-col items-center justify-center pt-5 pb-6">
        <Icon name="upload" class="text-2xl w-10" />
        <p class="mb-2 text-sm text-muted">
          <span class="font-semibold">{i18n.projects.click}</span>
          {i18n.projects.dragOne}
        </p>
        <p class="text-xs text-muted">{i18n.projects.formats}</p>
      </div>
      <input
        id="single-file-upload"
        name="imageFiles"
        type="file"
        accept="image/png,image/jpeg,image/jpg,image/webp,image/avif"
        class="sr-only"
      />
    </label>
  </div>
</dial-single-drop-zone>

<script src="@/lib/single-drop-zone"></script>