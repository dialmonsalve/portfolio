---
import Input from "@/components/form/Input.astro";
import Label from "@/components/form/Label.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/locales/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<dial-multi-tags>
  <div class="relative flex flex-col gap-2 w-75 lg:w-100">
    <Input id="input-tags" name="input-tags"  />
    <Label for="input-tags" absolute label="tags" />
    <button
      type="button"
      aria-label={t("addTag")}
      class="absolute right-3 top-1.5 text-[10px] cursor-pointer py-1 px-2 border border-base-300 bg-primary text-primary-content text-center rounded-full hover:opacity-80"
      >+</button
    >

    <div
      id="tags"
      class="bg-transparent placeholder:text-slate-400 text-sm border rounded-md px-3 py-2 transition-all duration-300 ease outline-none border-base-content/40 min-h-100 flex flex-wrap items-start gap-0.5"
    >
    </div>
  </div>
</dial-multi-tags>

<script src="@/lib/multi-tags"></script>
