---
import Icon from '@Icon/Icon.astro';
import DropDownButtons from './DropDownButtons.astro';

import { getI18N } from '@/i18n/index';

const currentLocale = Astro.currentLocale;

const i18n = getI18N({ currentLocale });
---

<app-theme>
  <details class="dropdown group">
    <summary class="btn m-1 btn-outline list-none [&::-webkit-details-marker]:hidden">
      {i18n.general.theme}
      <Icon name="arrow-down" class="w-2 transition-transform duration-200 group-open:rotate-180" />
    </summary>
    <ul
      class="dropdown-content rounded-box z-1 mt-1 w-52 border border-base-300 bg-base-100 p-2 shadow-lg -translate-x-30 md:-translate-x-25 lg:-translate-x-5"
    >
      <DropDownButtons />
    </ul>
  </details>
</app-theme>

<script>
  class AppTheme extends HTMLElement {
    constructor() {
      super();
      const element = document.documentElement;
      const currentTheme =
        localStorage.getItem('theme') || element.dataset.theme || 'light';

      const radiosThemes = this.querySelectorAll<HTMLInputElement>(
        'input[type="radio"]'
      );

      radiosThemes.forEach((radio) => {
        if (radio.value === currentTheme) {
          radio.checked = true;
        }

        radio.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          element.setAttribute('data-theme', target.value);
          localStorage.setItem('theme', target.value);
        });
      });
    }
  }

  customElements.define('app-theme', AppTheme);
</script>