---
import { LANGUAGES } from '@/const/languages';

import {
  useTranslatedPath,
  getLangFromUrl,
  getRouteFromUrl,
} from '@/i18n/locales/utils';
import Icon from '@Icon/Icon.astro';

const lang: "es" | "en" = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const route = getRouteFromUrl(Astro.url);
---

<div class="dropdown">
  <div tabindex="0" role="button" class="btn btn-outline btn-primary">
    {LANGUAGES[lang]}
    <Icon name="arrow-down" class="w-3" />
  </div>
  <ul
    tabindex="-1"
    class="dropdown-content rounded-box z-1 bg-base-300 w-52 p-2 shadow-2xl"
  >
    {
      Object.entries(LANGUAGES).map(([lang, label]) => (
        <li>
          <a
            class="w-full btn btn-sm btn-block btn-ghost justify-start capitalize"
            href={translatePath(`/${route ? route : '/'}`, lang)}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
