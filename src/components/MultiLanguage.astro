---
import { LANGUAGES } from '@/const/languages';

import {
  useTranslatedPath,
  getLangFromUrl,
  getRouteFromUrl,
} from '@/i18n/locales/utils';
import Icon from '@Icon/Icon.astro';

const lang: "es" | "en" = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const route = getRouteFromUrl(Astro.url);
---

<details class="dropdown group">
  <summary class="btn btn-outline btn-primary text-primary-strong hover:text-primary-content list-none [&::-webkit-details-marker]:hidden">
    {LANGUAGES[lang]}
    <Icon name="arrow-down" class="w-3 transition-transform duration-200 group-open:rotate-180" />
  </summary>
  <ul class="dropdown-content rounded-box z-1 mt-1 w-52 border border-base-300 bg-base-100 p-2 shadow-lg">
    {
      Object.entries(LANGUAGES).map(([code, label]) => (
        <li>
          <a
            class:list={[
              "w-full btn btn-sm btn-block justify-start capitalize",
              code === lang ? "btn-primary" : "btn-ghost",
            ]}
            href={translatePath(`/${route ? route : '/'}`, code)}
            hreflang={code}
            lang={code}
            aria-current={code === lang ? "true" : undefined}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</details>
