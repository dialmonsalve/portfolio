---
import { getEntry } from "astro:content";
import { getI18N } from "@/i18n";
import { getLangFromUrl, getPathname, useTranslations } from "@/i18n/locales/utils";

interface Props {
  isNotFound?: boolean;
}

const { isNotFound = false } = Astro.props;

const pathname = getPathname(Astro.url);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const i18n = getI18N({ currentLocale: lang });

const sectionNames: Record<string, string> = {
  projects: t("projects"),
  about: t("about"),
  ...Object.fromEntries(
    i18n.projects.internal_projects.map(({ href, title }) => [
      href.split("/").at(-1) ?? href,
      title,
    ]),
  ),
};

async function getName(part: string, parent: string | undefined) {
  if (parent === "projects" && !sectionNames[part]) {
    const project = await getEntry(
      lang === "en" ? "projects_en" : "projects_es",
      part,
    );
    if (project) return project.data.title;
  }
  return sectionNames[part] ?? part.replace(/-/g, " ");
}

const langPath = `/${lang}`;
const parts = pathname
  .replace(new RegExp(`^\\/${lang}`), "")
  .split("/")
  .filter(Boolean);

const breadcrumbs = [
  { name: t("home"), href: langPath },
  ...(await Promise.all(
    parts.map(async (part, index) => ({
      name: await getName(part, parts[index - 1]),
      href: `${langPath}/${parts.slice(0, index + 1).join("/")}`,
    })),
  )),
];

const site = Astro.site ?? Astro.url.origin;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map(({ name, href }, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name,
    item: new URL(href, site).href,
  })),
};
---

{
  !isNotFound && breadcrumbs.length > 0 && (
    <nav aria-label={t("breadcrumbs")}>
      <ul class="flex flex-wrap gap-1 pt-4 lg:pt-10 lg:pl-10">
        {breadcrumbs.map(({ href, name }) => (
          <li class="flex gap-1 items-center text-[12px]">
            {href !== pathname ? (
              <a
                class="block py-0.5 px-2 first-letter:uppercase rounded-r-xl border border-base-300 bg-base-200 text-base-content text-[12px] md:text-sm transition-colors duration-200 hover:border-primary hover:bg-primary hover:text-primary-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                href={href}
              >
                {name}
              </a>
            ) : (
              <span aria-current="page" class="block py-0.5 px-2 first-letter:uppercase rounded-r-xl border border-primary bg-primary text-primary-content text-[12px] md:text-sm">
                {name}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  !isNotFound && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  )
}
