---
import Icon from "@Icon/Icon.astro";
import { getI18N } from "@/i18n";

import { TECHNOLOGIES } from "@/const/technologies";

const i18n = getI18N({ currentLocale: Astro.currentLocale });
---

<div class="p-1 rounded-lg">
  <ul class="grid grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 tech-list">
    {
      TECHNOLOGIES.map(({ icon, name }) => (
        <li data-reveal="scroll" class="flex flex-col items-center group relative p-2 border border-gray-500 rounded-md shadow-2xl tech-item">
          <Icon
            name={icon}
            class="group-hover:scale-125 transition-all w-10 h-10 block icon-wrapper"
          />
          <span class="text-xs text-center block break-words md:text-lg">{name}</span>
        </li>
      ))
    }
  </ul>
  <a
    class="mt-3 text-xs hover:underline block text-end"
    target="_blank"
    href="https://iconos8.es/icons"
  >
    {i18n.general.iconsCredit}
    <span class="sr-only">{i18n.general.newTab}</span>
  </a>

</div>
