---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@/i18n/locales/utils";
import Icon from "./Icon.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="fab">
  <div
    tabindex="0"
    role="button"
    aria-label={t("menu")}
    class="btn btn-lg btn-circle btn-primary shadow-lg shadow-primary/30"
  >
    <Icon name="menu" class="w-7" />
  </div>

  <ul
    class="menu bg-base-100 border border-base-300 shadow-lg rounded-box flex flex-col justify-between content-between"
  >
    <li>
      <a
        class="tooltip tooltip-left"
        href={translatePath("/", lang)}
        data-tip={t("home")}
      >
        <Icon name="home" class="w-5" />
        {t("home")}
      </a>
    </li>
    <li>
      <a
        class="tooltip tooltip-left"
        href={translatePath("/about", lang)}
        data-tip={t("about")}
      >
        <Icon name="info" class="w-5" />
        {t("about")}
      </a>
    </li>
    <li>
      <a
        class="tooltip tooltip-left"
        href={translatePath("/projects", lang)}
        data-tip={t("projects")}
      >
        <Icon name="projects" class="w-5" />{t("projects")}
      </a>
    </li>
  </ul>
</div>

<style>
  @reference "../styles/global.css";
  .fab {
    opacity: 0;
    transform: translateY(-100vh);
    bottom: 8rem;
    animation: fab-fallback 0s 3s forwards;
  }

  @keyframes fab-fallback {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
  .fab {
    @apply md:right-15 lg:right-20;
  }
</style>
