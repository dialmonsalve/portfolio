---
interface Props {
  title: string;
  pngImage: string;
  webpImage: string;
  imageWidth: number;
  imageHeight: number;
  description: string;
  slug: string;
  isExternalProject: boolean;
  href: string;
  technology: string;
  scripts: string;
  styles: string;
}
import { getI18N } from "@/i18n";
import { getLangFromUrl, useTranslatedPath } from "@/i18n/locales/utils";

import Link from "./Link.astro";

const i18n = getI18N({ currentLocale: Astro.currentLocale });

const {
  title,
  pngImage,
  webpImage,
  imageWidth,
  imageHeight,
  description,
  slug,
  isExternalProject,
  href,
  scripts,
  styles,
  technology,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);

const translatePath = useTranslatedPath(lang);
---

<div
  data-reveal="scroll"
  data-tilt
  class="flex flex-col gap-8 border border-primary p-4 rounded-sm shadow-primary shadow-md justify-between items-center bg-base-200"
>
  <h2
    class="bg-primary text-primary-content px-2 py-1 -translate-y-8 uppercase rounded text-center"
    transition:name={slug}
  >
    {title}
  </h2>

  <div>
    <picture>
      <source srcset={webpImage} type="image/webp" />
      <img
        src={pngImage}
        alt={title}
        width={imageWidth}
        height={imageHeight}
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="flex flex-col gap-1 py-2">
      {
        isExternalProject && (
          <>
            <p class="text-md  flex items-center gap-2">
              {i18n.general.technology}:
              <span class="text-muted capitalize text-sm">
                {technology}
              </span>
            </p>
            <p class="text-md flex items-center gap-2">
              {i18n.general.styles}:
              <span class="text-muted capitalize text-sm">{styles}</span>
            </p>
            <p class="text-md flex items-center gap-2">
              Scripts:
              <span class="text-muted capitalize text-sm">{scripts}</span>
            </p>
          </>
        )
      }
    </div>
    <p class="text-muted text-sm h-12">{description}</p>
  </div>

  <ul class="flex justify-around w-full">
    {
      isExternalProject ? (
        <>
          <Link
            label={i18n.general.more}
            className="py-1 px-3 rounded-sm uppercase text-md text-primary-strong border border-primary transition-colors cursor-pointer hover:bg-primary hover:text-primary-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary buttons-more"
            href={`projects/${slug}`}
          />
          <Link
            target="_blank"
            label={i18n.general.go}
            className="py-1 px-3 rounded-sm uppercase text-md text-primary-content transition-opacity cursor-pointer bg-primary shadow-lg shadow-primary/30 hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href={href}
          />
        </>
      ) : (
        <Link
          label={i18n.general.go}
          className="py-1 px-3 rounded-sm uppercase text-md text-primary-content transition-opacity cursor-pointer bg-primary shadow-lg shadow-primary/30 hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          href={translatePath(`/${href ? href : ""}`, lang)}
        />
      )
    }
  </ul>
</div>
