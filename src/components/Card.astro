---
interface Props {
  title: string;
  pngImage: string;
  webpImage: string;
  imageWidth: number;
  imageHeight: number;
  description: string;
  slug: string;
  isExternalProject: boolean;
  href: string;
  technology: string;
  scripts: string;
  styles: string;
}
import { getI18N } from "@/i18n";
import { getLangFromUrl, useTranslatedPath } from "@/i18n/locales/utils";

import Link from "./Link.astro";

const i18n = getI18N({ currentLocale: Astro.currentLocale });

const {
  title,
  pngImage,
  webpImage,
  imageWidth,
  imageHeight,
  description,
  slug,
  isExternalProject,
  href,
  scripts,
  styles,
  technology,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);

const translatePath = useTranslatedPath(lang);

const chipClass = "rounded-full border border-base-300 px-2.5 py-0.5 text-xs text-muted capitalize";
const buttonBase =
  "inline-block rounded-lg px-3.5 py-2 text-sm font-medium first-letter:uppercase cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const primaryButton = `${buttonBase} bg-primary text-primary-content transition-opacity hover:opacity-85`;
const secondaryButton = `${buttonBase} border border-base-300 text-primary-strong transition-colors hover:border-primary hover:bg-base-200 buttons-more`;
---

<div
  data-reveal="scroll"
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 transition-colors duration-200 hover:border-primary"
>
  <picture class="block aspect-video overflow-hidden border-b border-base-300 bg-base-200">
    <source srcset={webpImage} type="image/webp" />
    <img
      src={pngImage}
      alt={title}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
      class="size-full object-cover object-top"
    />
  </picture>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <h2
      class="w-fit text-base font-semibold uppercase tracking-wide text-primary-strong"
      transition:name={slug}
    >
      {title}
    </h2>

    <p class="text-sm leading-6 text-muted first-letter:uppercase">{description}</p>

    {
      isExternalProject && (
        <ul class="flex flex-wrap gap-2">
          <li class={chipClass}>
            <span class="sr-only">{i18n.general.technology}:</span>
            {technology}
          </li>
          <li class={chipClass}>
            <span class="sr-only">{i18n.general.styles}:</span>
            {styles}
          </li>
          <li class={chipClass}>
            <span class="sr-only">Scripts:</span>
            {scripts}
          </li>
        </ul>
      )
    }

    <ul class="mt-auto flex flex-wrap gap-2 pt-2">
      {
        isExternalProject ? (
          <>
            <Link
              target="_blank"
              showArrow
              label={i18n.general.visit}
              className={primaryButton}
              href={href}
            />
            <Link
              label={i18n.general.more}
              className={secondaryButton}
              href={`projects/${slug}`}
            />
          </>
        ) : (
          <Link
            label={i18n.general.go}
            className={primaryButton}
            href={translatePath(`/${href ? href : ""}`, lang)}
          />
        )
      }
    </ul>
  </div>
</div>
