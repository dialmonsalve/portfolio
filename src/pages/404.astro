---
export const prerender = true;
import Layout from "@/layouts/MainLayout.astro";
import NotFoundIcon from "@/components/NotFound.astro";
import { getI18N } from "@/i18n";

const { currentLocale } = Astro;

const i18n = getI18N({ currentLocale });

const { subtitle, title, textButton, metaTitle, metaDescription} = i18n.notFound;
---

<Layout title={metaTitle} description={metaDescription} isNotFound>

  <div class="flex flex-col gap-8 items-center justify-center lg:h-[90dvh] p-4" >

    <div class="w-full md:w-1/2 mx-auto pt-10">
      <NotFoundIcon />
    </div>
    <h1 class="text-center text-3xl">{title}</h1>
    
    <p class="" >{subtitle}</p>
    
    <div >
      <a
        href={`/${currentLocale ?? "es"}`}
        class="btn btn-primary rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        {textButton}
      </a>
    </div>
  </div>

</Layout>