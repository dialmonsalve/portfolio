---
export const prerender = true;
import Layout from "@/layouts/MainLayout.astro";
import { getI18N } from "@/i18n";

import MultiTabs from "@/components/web-components/MultiTabs.astro";
import MultiSelect from "@/components/web-components/MultiSelect.astro";
import Tags from "@/components/web-components/Tags.astro";
import Carousel from "@/components/web-components/Carousel.astro";
import SingleDropZone from "@/components/web-components/SingleDropZone.astro";
import { getLangStaticPaths } from "@/i18n/locales/utils";

export const getStaticPaths = getLangStaticPaths;

const { currentLocale } = Astro;

const i18n = getI18N({ currentLocale });

const title = i18n.projects.web_components.title;

const webComponentsProjects = i18n.meta.webComponentsProjects;
---

<Layout
  title={webComponentsProjects.metaTitle}
  description={webComponentsProjects.metaDescription}
>
  <section class="flex flex-col gap-8 items-center px-1">
    <h1
      class="text-2xl text-center uppercase"
      transition:name="web-components"
    >
      {title}
    </h1>

    <div class="flex w-fit max-w-full flex-col gap-16">
      <div class="flex w-full flex-col gap-1 contain-[inline-size]">
        <div class="uppercase text-muted">
          <h2>{i18n.projects.web_components.carousel.title}</h2>
          <p class="text-xs text-muted">
            {i18n.projects.web_components.carousel.help}
          </p>
        </div>
        <Carousel />
      </div>

      <article class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-20">
        <div class="flex flex-col gap-1">
          <h2 class="uppercase text-muted">Multi Tabs</h2>
          <MultiTabs />
        </div>

        <div class="flex flex-col gap-1">
          <h2 class="uppercase text-muted">
            Dial Drop Zone
          </h2>
          <SingleDropZone />
        </div>

        <div class="flex flex-col gap-1">
          <div class="uppercase text-muted">
            <h2>Multi Select</h2>
            <p class="text-xs text-muted">
              {i18n.projects.web_components.multiSelectHelp1}
            </p>
            <p class="text-xs text-muted">
              {i18n.projects.web_components.multiSelectHelp2}
            </p>
          </div>
          <MultiSelect />
        </div>

        <div class="flex flex-col gap-1">
          <h2 class="uppercase text-muted">Tags</h2>
          <Tags />
        </div>
      </article>
    </div>
  </section>
</Layout>
