---
export const prerender = true;
import { getCollection, render } from "astro:content";
import Link from "@/components/Link.astro";
import Layout from "@/layouts/MainLayout.astro";
import { getI18N } from "@/i18n";

import { getLangStaticPaths } from "@/i18n/locales/utils";

export async function getStaticPaths() {
  const paths = await Promise.all(
    getLangStaticPaths().map(async ({ params: { lang } }) => {
      const projects = await getCollection(`projects_${lang}` as "projects_es");
      return projects.map((project) => ({
        params: { lang, slug: project.data.slug },
        props: { project },
      }));
    }),
  );
  return paths.flat();
}

const { project } = Astro.props;
const { slug } = Astro.params;

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const {
  metaTitle,
  metaDescription,
  description,
  href,
  images,
  scripts,
  styles,
  technology,
  title,
} = project.data;

const { Content } = await render(project);
---

<Layout title={metaTitle} description={metaDescription}>
  <section class="flex flex-col gap-5 lg:w-80/100 mx-auto pt-10 px-4 md:p-1">
    <h1
      class="uppercase text-center text-3xl text-primary"
      transition:name={slug}
    >
      {title}
    </h1>
    <ul>
      <Link
        className="bg-primary text-white w-fit px-4 rounded-xl shadow-2xl shadow-primary hover:opacity-80 capitalize"
        href={href}
        label={i18n.general.go}
        target="_blank"
      />
    </ul>

    <div
      class="grid grid-cols-1 w-2/3 md:w-auto sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-6 justify-items-center mx-auto"
    >
      {
        images.map((_, idx) => (
          <picture>
            <source
              srcset={`/images/${slug}/webp/${idx + 1}.webp`}
              type="image/webp"
            />
            <img
              src={`/images/${slug}/png/${idx + 1}.png`}
              alt={i18n.general.screenshot
                .replace("{n}", `${idx + 1}`)
                .replace("{title}", title)}
              class="max-w-full h-70 object-cover block rounded-xl shadow-md shadow-gray-300 dark:shadow-slate-600"
            />
          </picture>
        ))
      }
    </div>
    <div class="">
      <Content />
    </div>
    <p class="text-base">
      <span class="font-bold uppercase text-error"
        >{i18n.general.description}:</span
      >
      {description}
    </p>
    <p class="text-base">
      <span class="font-bold uppercase text-error"
        >{i18n.general.technology}:</span
      >
      {technology}
    </p>
    <p class="text-base">
      <span class="font-bold uppercase text-error">{i18n.general.styles}:</span>
      {styles}
    </p>
    <p class="text-base">
      <span class="font-bold uppercase text-error">Scripts:</span>
      {scripts}
    </p>
  </section>
</Layout>
