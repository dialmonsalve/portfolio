---
export const prerender = true;
import { getI18N } from "@/i18n";
import Layout from "@/layouts/MainLayout.astro";
import Card from "@/components/Card.astro";
import { getCollection } from "astro:content";
import { getLangStaticPaths } from "@/i18n/locales/utils";

export const getStaticPaths = getLangStaticPaths;

const currentLocale = Astro.currentLocale;

const i18n = getI18N({ currentLocale });

const projects = await getCollection(
  currentLocale === "en" ? "projects_en" : "projects_es",
);

const { meta } = i18n;
---

<Layout
  title={meta.projects.metaTitle}
  description={meta.projects.metaDescription}
>
  <section class="flex flex-col gap-15 w-80/100 mx-auto">
    <h1
      class="uppercase text-center text-2xl"
      transition:animate="slide"
    >
      {i18n.projects.title}
    </h1>

    <article
      class="grid gap-8 grid-cols-1 md:grid-cols-2 xl:grid-cols-3 xl:w-3/4 mx-auto"
    >
      {
        projects.map(({ data }) => (
          <Card
            title={data.title}
            pngImage={data.pngImage}
            webpImage={data.webpImage}
            imageWidth={data.imageWidth}
            imageHeight={data.imageHeight}
            description={data.description}
            isExternalProject={true}
            href={data.href}
            styles={data.styles}
            technology={data.technology}
            scripts={data.scripts}
            slug={data.slug}
          />
        ))
      }
    </article>

    <article
      class="grid gap-8 grid-cols-1 md:grid-cols-2 xl:grid-cols-3 xl:w-3/4 mx-auto"
    >
      {
        i18n.projects.internal_projects.map(
          ({
            description,
            href,
            pngImage,
            webpImage,
            imageWidth,
            imageHeight,
            slug,
            title,
          }) => (
            <Card
              title={title}
              pngImage={pngImage}
              webpImage={webpImage}
              imageWidth={imageWidth}
              imageHeight={imageHeight}
              description={description}
              slug={slug}
              isExternalProject={false}
              href={href}
              styles=""
              technology=""
              scripts=""
            />
          )
        )
      }
    </article>
  </section>
</Layout>